{
  "name": "finture-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "db:seed:base": "tsx scripts/seed-demo.ts --base",
    "db:seed:demo": "node -e \"process.env.RADAR_DB_DIR='.data/pglite-demo';require('child_process').execSync('tsx scripts/seed-demo.ts',{stdio:'inherit',env:process.env})\"",
    "dev:demo": "node -e \"process.env.RADAR_DB_DIR='.data/pglite-demo';require('child_process').execSync('next dev -p 3211',{stdio:'inherit',env:process.env})\"",
    "receita:baixar": "python -I scripts/receita-baixar-filtrar.py",
    "receita:importar": "tsx scripts/import-receita.ts",
    "receita:sites": "tsx scripts/enriquecer-sites.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
